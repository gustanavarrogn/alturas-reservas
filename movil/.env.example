# Copia este archivo como .env y pega los valores de tu proyecto de Firebase
# (Consola de Firebase > Configuración del proyecto > Tus apps > App web > firebaseConfig).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Inicio de sesión con Google (Authentication > Sign-in method > Google > Web SDK configuration).
# El Web client ID basta para la versión web (npx expo start --web).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Opcionales: solo para Google dentro de un development build de Android/iOS.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
