rules_version = '2';

// Reglas de seguridad de Cloud Firestore para Alturas Reservas.
// Cada cliente solo puede leer y modificar su propio perfil y sus propias reservas.
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function esDueno(uid) {
      return autenticado() && request.auth.uid == uid;
    }

    function esAdmin() {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    // Perfil: lo crea su dueño como "cliente" y después solo puede cambiar nombre y teléfono.
    match /usuarios/{uid} {
      allow read: if esDueno(uid) || esAdmin();
      allow create: if esDueno(uid)
        && request.resource.data.rol == 'cliente'
        && request.resource.data.keys().hasOnly(['nombre', 'correo', 'telefono', 'rol', 'proveedor', 'creadoEn'])
        && request.resource.data.creadoEn == request.time;
      allow update: if esDueno(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'telefono', 'actualizadoEn']);
      allow delete: if false;
    }

    // Reservas: ligadas al uid de quien las crea; solo se permite pasar de Confirmada a Cancelada.
    match /reservas/{id} {
      allow read: if autenticado() && (resource.data.uid == request.auth.uid || esAdmin());
      allow create: if autenticado()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'correo', 'nombre', 'codigo', 'fecha', 'hora', 'personas', 'tipo', 'mesa', 'estado', 'creadoEn', 'canceladoEn'])
        && request.resource.data.estado == 'Confirmada'
        && request.resource.data.personas is int
        && request.resource.data.personas >= 1 && request.resource.data.personas <= 6
        && request.resource.data.tipo in ['Almuerzo', 'Cena', 'Celebración', 'Otro']
        && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.hora.matches('^[0-9]{2}:[0-9]{2}$')
        && request.resource.data.creadoEn == request.time;
      allow update: if autenticado()
        && (resource.data.uid == request.auth.uid || esAdmin())
        && resource.data.estado == 'Confirmada'
        && request.resource.data.estado == 'Cancelada'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'canceladoEn']);
      allow delete: if esAdmin();
    }

    // Ocupación de mesas: sin datos personales, cualquier usuario autenticado la puede consultar.
    // Solo se crea junto con una reserva propia (misma transacción) y solo la borra su dueño.
    match /ocupacion/{clave} {
      allow read: if autenticado();
      allow create: if autenticado()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['fecha', 'hora', 'mesa', 'uid', 'reservaId'])
        && getAfter(/databases/$(database)/documents/reservas/$(request.resource.data.reservaId)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/reservas/$(request.resource.data.reservaId)).data.mesa == request.resource.data.mesa;
      allow update: if false;
      allow delete: if autenticado() && (resource.data.uid == request.auth.uid || esAdmin());
    }
  }
}
